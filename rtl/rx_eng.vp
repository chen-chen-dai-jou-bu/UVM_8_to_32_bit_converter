`timescale 1ns/100ps
/********************************************************************************
 * Design Name       : Serial In and Parallel Out RX Engine, From 8 bits to 32 bits
 * Function          : Collects incoming 8-bit bytes and assembles them
 *                     into 32-bit parallel words with LSB-first packing;
 *                     supports full and partial beats (pad-zero flush),
 *                     and generates valid_out, byte_cnt mask, and last pulse.
 * File Name         : rtl/rx_eng.v
 * Original Author   : Michael Su, Sr. Consultant, SiCADA
 * Version           : 2.0
 * Modification Date : 2025-08-15
 * Modified by       : Hua-Chen Wu
 * Modification Date : 2026-01-08
 * Modified by       : Michael Su
 * Modifications     :
 *   ??flush_partial:
 *       ??per updated spec, when RXDV deasserts with leftover bytes
 *         (byte_no != 2?™b00), do NOT output immediately;
 *         instead enter a pad-zero phase of (4 - byte_no) cycles,
 *         then assert valid_out once after full 4-byte beat.
 *       ??add flush_cnt to count pad cycles, ensuring fixed 4-cycle interval
 *         between valid_out pulses regardless of leftover bytes.
 *   ??pack_lsbfirst:
 *       ??change data packing into LSB-first order instead of MSB-first
 *       ??implement packing by OR'ing new byte into proper 8-bit slot:
 *           data_out <= data_out | (rxd << (8 * byte_no));
 *       ??update byte_vld mask shifting to LSB-first for both full and partial words
 *   ??pack_lsbfirst_eco:
 *       ??beat-boundary clear: on first byte of each 4-byte beat,
 *         clear data_out before OR-accumulating new byte to avoid residual bits
 *   ??fix_byte_no_increment:
 *       ??ensure byte_no is incremented when receiving the first byte
 *         so that subsequent bytes advance correctly and valid_out can fire
 *   ??add_last_signal:
 *       ??introduce output reg last to indicate the final 32-bit word
 *       ??reset last to 0 on reset, normal receive, and idle
 *       ??on partial-flush final cycle, assert last=1 alongside valid_out
 *   ??pack_shift_width_fix (NEW, safety):
 *       ??widen rxd to 32-bit before shifting to avoid truncation on some tools:
 *           ({24'h0, rxd}) << (8 * byte_no)
 *   ??Bug_fix : 4-byte align fails to assert last signal (2026-01-08)
 *       ??Remove flush_cnt due to useless and use rxing instead to control
 ********************************************************************************/

module rx_eng (
    input             clk,				// Clock input
    input             rst_n,			// Asynchronous reset (active low), synchronous release
    input             conv_en,		// Conversion enable: hold high during valid bytes
    input             rxdv,				// RX data valid indicator
    input       [7:0] rxd,				// Incoming serial byte
    output reg        valid_out,	// Asserted when a 32-bit word is ready
    output reg        last,				// Asserted high on the cycle of the final word
    output reg  [9:0] byte_cnt,		// Receive Byte Count
    output reg [31:0] data_out		// Assembled 32-bit parallel output
);

  // byte_no    : position within 4-byte window (00,01,10,11)
  // byte_vld   : valid byte of data_out
  // rxing      : high when in receive or flush state
  reg [1:0] byte_no;
  reg [3:0] byte_vld;
  reg       rxing;

